rules_version = '2';

// Denegar todo por defecto: solo se abre lo que se declara abajo.
// Estadísticas, récords, rankings y resultados solo los escribe el servidor
// (Cloud Functions / Admin SDK, que no pasa por estas reglas).
//
// Unicidad del @username: `users/{uid}` y `usernames/{username}` se escriben
// en la misma transacción. Las reglas usan getAfter/existsAfter para exigir
// que ambos documentos queden coherentes, y `usernames` nunca se actualiza,
// así que dos clientes no pueden reservar el mismo nombre.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.superAdmin == true
        // Bootstrap temporal de la cuenta operativa (preferir Custom Claim).
        || request.auth.token.email == 'administracion@tinguar.com'
      );
    }

    function isValidUsername(name) {
      return name is string && name.matches('^[a-z0-9_]{3,20}$');
    }

    function isValidAvatar(data) {
      return data.avatarStyle in [
          'adventurer', 'avataaars', 'big-smile', 'fun-emoji', 'lorelei',
          'micah', 'notionists', 'open-peeps', 'pixel-art', 'thumbs'
        ]
        && data.avatarSeed is string
        && data.avatarSeed.matches('^[A-Za-z0-9_-]{1,64}$')
        && data.avatarOptions is map
        && data.avatarOptions.keys().hasOnly(['backgroundColor'])
        && (!('backgroundColor' in data.avatarOptions)
            || data.avatarOptions.backgroundColor in [
              'ffc53d', 'ff8a5b', '2ed3a1', '7cc4ff',
              'b69cff', 'ff7eb6', 'f1e4d3', '22222d'
            ]);
    }

    function isValidProfile(uid, data) {
      return data.keys().hasOnly([
          'uid', 'username', 'displayName', 'displayNameLower', 'bio',
          'avatarStyle', 'avatarSeed', 'avatarOptions', 'visibility',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'uid', 'username', 'displayName', 'bio',
          'avatarStyle', 'avatarSeed', 'avatarOptions', 'visibility',
          'isActive', 'createdAt', 'updatedAt'
        ])
        && (!('displayNameLower' in data)
            || (data.displayNameLower is string
                && data.displayNameLower.size() <= 40))
        && data.uid == uid
        && isValidUsername(data.username)
        && data.displayName is string
        && data.displayName.size() <= 40
        && data.displayName.matches('(?s).*\\S.*')
        && data.bio is string
        && data.bio.size() <= 160
        && isValidAvatar(data)
        && data.visibility in ['public', 'private']
        && data.isActive is bool
        && data.updatedAt == request.time;
    }

    function usernameReservedBy(name, uid) {
      return getAfter(/databases/$(database)/documents/usernames/$(name)).data.uid == uid;
    }

    // Perfil: dueño siempre; terceros solo si visibility=public.
    match /users/{uid} {
      allow get: if isOwner(uid)
        || (resource.data.isActive == true
            && resource.data.visibility == 'public');
      // Búsqueda: la query debe filtrar visibility==public (regla de get).
      allow list: if isSignedIn();

      allow create: if isOwner(uid)
        && isValidProfile(uid, request.resource.data)
        && request.resource.data.isActive == true
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdAt == request.time
        && usernameReservedBy(request.resource.data.username, uid);

      allow update: if isOwner(uid)
        && isValidProfile(uid, request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'username', 'displayName', 'displayNameLower', 'bio',
          'avatarStyle', 'avatarSeed', 'avatarOptions', 'visibility',
          'updatedAt'
        ])
        && (request.resource.data.username == resource.data.username
            || (usernameReservedBy(request.resource.data.username, uid)
                && !existsAfter(/databases/$(database)/documents/usernames/$(resource.data.username))));

      allow delete: if false;

      // Datos privados (correo). Nunca forman parte del perfil público.
      match /private/account {
        allow get: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['email', 'updatedAt'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    // Índice de unicidad: usernames/{username} = { uid, createdAt }.
    match /usernames/{name} {
      // Leer un nombre concreto permite comprobar disponibilidad;
      // listar el índice completo no está permitido.
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isValidUsername(name)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == name;

      // Nunca se reasigna: si el documento existe, el nombre está ocupado.
      allow update: if false;

      // Solo se libera al cambiar de username en la misma transacción.
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username != name;
    }

    // Contadores: lectura según privacidad; escritura en § Fase 5 (Spark host).
    // (reglas de escritura más abajo junto a leaderboards)

    // Catálogo público de solo lectura (se mantiene con el script de seed).
    match /categories/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Fase 9.1: establecimientos (solicitudes + admin).
    function restaurantPublicRead() {
      return resource.data.status == 'approved'
        || resource.data.isActive == true;
    }

    // Lectura por creatorUserId (incluye listados `where creatorUserId == uid`).
    // No filtrar por status aquí: en queries list Firestore exige que la regla
    // quede garantizada solo con los filtros del query.
    function restaurantCreatorRead() {
      return isSignedIn()
        && resource.data.creatorUserId == request.auth.uid;
    }

    function restaurantOwnerRead() {
      return isSignedIn()
        && resource.data.ownerUserId == request.auth.uid;
    }

    function restaurantOwnerPublicUpdateKeys() {
      return [
          'name', 'slug', 'normalizedName', 'nameLower',
          'city', 'country', 'address', 'description', 'imageUrl', 'logoUrl',
          'categoryIds', 'latitude', 'longitude', 'updatedAt',
          'phone', 'whatsapp', 'websiteUrl',
          'instagramUrl', 'facebookUrl', 'tiktokUrl',
          'galleryUrls', 'videoUrls'
        ];
    }

    function restaurantAdminStatusUpdateKeys() {
      return [
          'status', 'isActive', 'updatedAt',
          'approvedAt', 'approvedByUserId',
          'rejectedAt', 'rejectedByUserId', 'rejectionReason',
          'suspendedAt', 'suspendedByUserId', 'suspensionReason',
          'ownerUserId'
        ];
    }

    match /restaurants/{id} {
      allow get, list: if restaurantPublicRead()
        || restaurantCreatorRead()
        || restaurantOwnerRead()
        || isSuperAdmin();

      allow create: if isSignedIn()
        && request.resource.data.creatorUserId == request.auth.uid
        && request.resource.data.ownerUserId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.isActive == false
        && request.resource.data.name is string
        && request.resource.data.name.matches('(?s).*\\S.*')
        && request.resource.data.city is string
        && request.resource.data.country is string;

      allow update: if (isSignedIn()
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.status == resource.data.status
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.creatorUserId == resource.data.creatorUserId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(restaurantOwnerPublicUpdateKeys()))
        || (isSuperAdmin()
          && request.resource.data.creatorUserId == resource.data.creatorUserId
          && request.resource.data.updatedAt == request.time
          && request.resource.data.status in
              ['pending', 'approved', 'rejected', 'suspended']
          && request.resource.data.isActive is bool
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(restaurantAdminStatusUpdateKeys()));

      allow delete: if false;
    }

    match /establishmentAuditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /establishmentOwnershipTransfers/{transferId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ───────────────────────── Fase 3: retos ─────────────────────────
    //
    // Cada escritura del cliente va en una transacción o batch, y las reglas
    // exigen que todos los documentos implicados queden coherentes
    // (getAfter/existsAfter):
    //   · crear      = challenge + inviteCodes/{code} + participants/{host}
    //   · unirse     = participantIds (+uid) + participants/{uid}
    //   · salir      = participantIds (−uid) − participants/{uid}
    //   · +1 / −1    = events/{clientEventId} + participants/{uid}.currentCount
    //   · finalizar  = status finished + challengeResults/{id}
    // Así `currentCount` siempre es la suma de los eventos del usuario y el
    // resultado siempre es la copia exacta de los contadores al cerrar.

    function challengePath(id) {
      return /databases/$(database)/documents/challenges/$(id);
    }

    function participantPath(id, uid) {
      return /databases/$(database)/documents/challenges/$(id)/participants/$(uid);
    }

    function eventPath(id, eventId) {
      return /databases/$(database)/documents/challenges/$(id)/events/$(eventId);
    }

    function isMemberOf(id) {
      return isSignedIn()
        && request.auth.uid in get(challengePath(id)).data.participantIds;
    }

    function isValidInviteCode(code) {
      return code is string
        && code.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{6}$');
    }

    function isValidChallenge(id, data) {
      return data.keys().hasOnly([
          'hostUserId', 'categoryId', 'restaurantId', 'title', 'description',
          'inviteCode', 'visibility', 'status', 'maxParticipants',
          'participantIds', 'sameDevicePlay', 'sameDevicePartnerId',
          'partnerResultStatus', 'createdAt', 'startedAt', 'finishedAt',
          'updatedAt'
        ])
        && data.keys().hasAll([
          'hostUserId', 'categoryId', 'restaurantId', 'title', 'description',
          'inviteCode', 'visibility', 'status', 'maxParticipants',
          'participantIds', 'sameDevicePlay', 'sameDevicePartnerId',
          'partnerResultStatus', 'createdAt', 'startedAt', 'finishedAt',
          'updatedAt'
        ])
        && data.categoryId is string
        && exists(/databases/$(database)/documents/categories/$(data.categoryId))
        && (data.restaurantId == null
            || (data.restaurantId is string
                && exists(/databases/$(database)/documents/restaurants/$(data.restaurantId))))
        && data.title is string && data.title.size() <= 60
        && data.description is string && data.description.size() <= 280
        && isValidInviteCode(data.inviteCode)
        && data.visibility in ['private', 'public', 'friends']
        && data.maxParticipants is int
        && data.maxParticipants >= 1 && data.maxParticipants <= 8
        && data.sameDevicePlay is bool
        && (data.sameDevicePartnerId == null || data.sameDevicePartnerId is string)
        && data.partnerResultStatus in [
          'notRequired', 'pending', 'confirmed', 'rejected'
        ];
        // sameDevicePlay admite 2..8 (host + amigos/invitados).
    }

    // El snapshot del participante debe coincidir con su perfil real.
    function isValidParticipant(uid, data, role) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasOnly([
          'userId', 'username', 'displayName', 'avatarStyle', 'avatarSeed',
          'avatarOptions', 'role', 'status', 'currentCount', 'lastEventId',
          'joinedAt'
        ])
        && data.userId == uid
        && data.username == user.username
        && data.displayName == user.displayName
        && data.avatarStyle == user.avatarStyle
        && data.avatarSeed == user.avatarSeed
        // avatarOptions: no exigir igualdad exacta (mapas vacios vs ausentes).
        && data.avatarOptions is map
        && data.role == role
        && data.status == 'joined'
        && data.currentCount == 0
        && data.lastEventId == null
        && data.joinedAt == request.time;
    }

    function eventDelta(type) {
      return type == 'increment' ? 1 : -1;
    }

    // Entrada i del resultado = contador real del participante i.
    function isResultEntry(id, entries, uids, i) {
      let p = get(participantPath(id, uids[i])).data;
      return entries[i].keys().hasOnly([
          'userId', 'username', 'displayName', 'avatarStyle', 'avatarSeed',
          'avatarOptions', 'count'
        ])
        && entries[i].userId == uids[i]
        && entries[i].count == p.currentCount
        && entries[i].username == p.username
        && entries[i].displayName == p.displayName;
    }

    // Desenrollado hasta Challenge.maxParticipantsLimit (8).
    function isExactResult(id, entries, uids) {
      let n = uids.size();
      return entries.size() == n
        && (n <= 0 || isResultEntry(id, entries, uids, 0))
        && (n <= 1 || isResultEntry(id, entries, uids, 1))
        && (n <= 2 || isResultEntry(id, entries, uids, 2))
        && (n <= 3 || isResultEntry(id, entries, uids, 3))
        && (n <= 4 || isResultEntry(id, entries, uids, 4))
        && (n <= 5 || isResultEntry(id, entries, uids, 5))
        && (n <= 6 || isResultEntry(id, entries, uids, 6))
        && (n <= 7 || isResultEntry(id, entries, uids, 7));
    }

    match /challenges/{challengeId} {
      // Get: quien entra con código. List: propios O retos publicos
      // (Explorar / ficha de local: where visibility==public).
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds
            || resource.data.visibility == 'public');

      allow create: if isSignedIn()
        && isValidChallenge(challengeId, request.resource.data)
        && request.resource.data.hostUserId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.participantIds == [request.auth.uid]
        && request.resource.data.sameDevicePartnerId == null
        && request.resource.data.partnerResultStatus == 'notRequired'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.startedAt == null
        && request.resource.data.finishedAt == null
        && getAfter(/databases/$(database)/documents/inviteCodes/$(request.resource.data.inviteCode)).data.challengeId == challengeId
        && existsAfter(participantPath(challengeId, request.auth.uid));

      allow update: if isSignedIn()
        && request.resource.data.updatedAt == request.time
        && (isJoin() || isLeave() || isStart() || isFinish() || isCancel()
            || isSameDeviceAddPartner() || isPartnerResultConfirm());

      allow delete: if false;

      function isHost() {
        return resource.data.hostUserId == request.auth.uid;
      }

      function changes(keys) {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(keys.concat(['updatedAt']));
      }

      // Unirse: la lista nueva es exactamente la anterior + el usuario, y
      // cabe. Con dos clientes a la vez, el segundo parte de una lista vieja
      // y no cumple la igualdad: la transacción reintenta y ve el reto lleno.
      function isJoin() {
        return resource.data.status == 'waiting'
          && !(request.auth.uid in resource.data.participantIds)
          && changes(['participantIds'])
          && request.resource.data.participantIds
              == resource.data.participantIds.concat([request.auth.uid])
          && request.resource.data.participantIds.size() <= resource.data.maxParticipants
          && existsAfter(participantPath(challengeId, request.auth.uid));
      }

      function isLeave() {
        return resource.data.status == 'waiting'
          && !isHost()
          && request.auth.uid in resource.data.participantIds
          && changes(['participantIds'])
          && request.resource.data.participantIds
              == resource.data.participantIds.removeAll([request.auth.uid])
          && !existsAfter(participantPath(challengeId, request.auth.uid));
      }

      function isStart() {
        return isHost()
          && resource.data.status == 'waiting'
          && request.resource.data.status == 'active'
          && request.resource.data.startedAt == request.time
          && changes(['status', 'startedAt']);
      }

      function isFinish() {
        return isHost()
          && resource.data.status == 'active'
          && request.resource.data.status == 'finished'
          && request.resource.data.finishedAt == request.time
          && existsAfter(/databases/$(database)/documents/challengeResults/$(challengeId))
          && (
            // Retos antiguos o normales (sin mismo celular).
            ((!('sameDevicePlay' in resource.data)
                || resource.data.sameDevicePlay != true)
              && changes(['status', 'finishedAt']))
            ||
            // Amigo(s) en mismo celular: pide confirmacion.
            (('sameDevicePlay' in resource.data)
              && resource.data.sameDevicePlay == true
              && resource.data.participantIds.size() >= 2
              && request.resource.data.partnerResultStatus == 'pending'
              && changes(['status', 'finishedAt', 'partnerResultStatus']))
            ||
            // Partida libre / guest sin amigos: no requiere confirmacion.
            (('sameDevicePlay' in resource.data)
              && resource.data.sameDevicePlay == true
              && request.resource.data.partnerResultStatus == 'notRequired'
              && changes(['status', 'finishedAt']))
          );
      }

      function isCancel() {
        return isHost()
          && resource.data.status in ['draft', 'waiting', 'active']
          && request.resource.data.status == 'cancelled'
          && changes(['status']);
      }

      // Host añade compañero(s) de mismo celular (amigo o cuenta libre).
      function isSameDeviceAddPartner() {
        return isHost()
          && resource.data.status == 'waiting'
          && resource.data.sameDevicePlay == true
          && request.resource.data.sameDevicePlay == true
          && request.resource.data.sameDevicePartnerId is string
          && request.resource.data.sameDevicePartnerId != request.auth.uid
          && !(request.resource.data.sameDevicePartnerId in resource.data.participantIds)
          && changes(['participantIds', 'sameDevicePartnerId'])
          && request.resource.data.participantIds
              == resource.data.participantIds.concat([
                request.resource.data.sameDevicePartnerId
              ])
          && request.resource.data.participantIds.size()
              <= resource.data.maxParticipants
          && exists(/databases/$(database)/documents/users/$(request.resource.data.sameDevicePartnerId))
          && existsAfter(participantPath(
              challengeId, request.resource.data.sameDevicePartnerId));
      }

      function isPartnerResultConfirm() {
        return resource.data.status == 'finished'
          && resource.data.sameDevicePlay == true
          && resource.data.partnerResultStatus == 'pending'
          && request.auth.uid in resource.data.participantIds
          && request.auth.uid != resource.data.hostUserId
          && request.resource.data.partnerResultStatus in ['confirmed', 'rejected']
          && changes(['partnerResultStatus']);
      }

      match /participants/{uid} {
        allow read: if isMemberOf(challengeId);

        // Anfitrión al crear, usuario al unirse, o host añadiendo compañero
        // de mismo celular.
        allow create: if getAfter(challengePath(challengeId)).data.status == 'waiting'
          && uid in getAfter(challengePath(challengeId)).data.participantIds
          && isValidParticipant(
            uid,
            request.resource.data,
            getAfter(challengePath(challengeId)).data.hostUserId == uid
                ? 'host'
                : 'participant'
          )
          && (
            isOwner(uid)
            || (
              getAfter(challengePath(challengeId)).data.hostUserId == request.auth.uid
              && getAfter(challengePath(challengeId)).data.sameDevicePlay == true
              && uid != getAfter(challengePath(challengeId)).data.hostUserId
            )
          );

        // Contador propio, o host contando por el compañero en mismo celular.
        allow update: if get(challengePath(challengeId)).data.status == 'active'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentCount', 'lastEventId'])
          && request.resource.data.lastEventId is string
          && request.resource.data.currentCount is int
          && request.resource.data.currentCount >= 0
          && !exists(eventPath(challengeId, request.resource.data.lastEventId))
          && getAfter(eventPath(challengeId, request.resource.data.lastEventId)).data.userId == uid
          && request.resource.data.currentCount == resource.data.currentCount
              + eventDelta(getAfter(eventPath(challengeId, request.resource.data.lastEventId)).data.type)
          && (
            isOwner(uid)
            || (
              get(challengePath(challengeId)).data.sameDevicePlay == true
              && get(challengePath(challengeId)).data.hostUserId == request.auth.uid
              && uid in get(challengePath(challengeId)).data.participantIds
              && uid != request.auth.uid
            )
          );

        // Salir: solo en la sala de espera y quitándose de participantIds.
        allow delete: if isOwner(uid)
          && resource.data.role != 'host'
          && get(challengePath(challengeId)).data.status == 'waiting'
          && !(uid in getAfter(challengePath(challengeId)).data.participantIds);
      }

      // Eventos inmutables (id = clientEventId → idempotencia). Un reintento
      // con el mismo id es un update y se rechaza: no se cuenta dos veces.
      match /events/{eventId} {
        allow read: if isMemberOf(challengeId);

        allow create: if isSignedIn()
          && eventId.matches('^[A-Za-z0-9]{20}$')
          && request.resource.data.keys().hasOnly([
              'clientEventId', 'userId', 'type', 'amount', 'createdAt'
            ])
          && request.resource.data.keys().hasAll([
              'clientEventId', 'userId', 'type', 'amount', 'createdAt'
            ])
          && request.resource.data.clientEventId == eventId
          && request.resource.data.type in ['increment', 'decrement']
          && request.resource.data.amount == 1
          && request.resource.data.createdAt == request.time
          && get(challengePath(challengeId)).data.status == 'active'
          && (
            request.resource.data.userId == request.auth.uid
            || (
              get(challengePath(challengeId)).data.sameDevicePlay == true
              && get(challengePath(challengeId)).data.hostUserId == request.auth.uid
              && request.resource.data.userId
                  in get(challengePath(challengeId)).data.participantIds
              && request.resource.data.userId != request.auth.uid
            )
          )
          && getAfter(participantPath(challengeId, request.resource.data.userId)).data.lastEventId == eventId
          && getAfter(participantPath(challengeId, request.resource.data.userId)).data.currentCount
              == get(participantPath(challengeId, request.resource.data.userId)).data.currentCount
                + eventDelta(request.resource.data.type);

        allow update, delete: if false;
      }
    }

    // Reserva de códigos: inviteCodes/{code} = { challengeId, createdAt }.
    // Create-only → dos retos no pueden quedarse con el mismo código.
    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isValidInviteCode(code)
        && request.resource.data.keys().hasOnly(['challengeId', 'createdAt'])
        && request.resource.data.challengeId is string
        && request.resource.data.createdAt == request.time
        && !exists(challengePath(request.resource.data.challengeId))
        && getAfter(challengePath(request.resource.data.challengeId)).data.inviteCode == code
        && getAfter(challengePath(request.resource.data.challengeId)).data.hostUserId == request.auth.uid;

      allow update, delete: if false;
    }

    // Resultado inmutable. Lo escribe el anfitrión al finalizar, en la misma
    // transacción, y debe ser la copia exacta de los contadores.
    match /challengeResults/{challengeId} {
      // Un resultado que aún no existe se puede "leer" (vacío) para que el
      // listener no falle antes de finalizar.
      allow get: if isSignedIn()
        && (resource == null
            || request.auth.uid in resource.data.participantIds
            || resource.data.hostUserId == request.auth.uid);
      // Host puede listar por hostUserId (backfill Spark); participante por array-contains.
      allow list: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds
            || resource.data.hostUserId == request.auth.uid);

      allow create: if isSignedIn()
        && get(challengePath(challengeId)).data.hostUserId == request.auth.uid
        && get(challengePath(challengeId)).data.status == 'active'
        && getAfter(challengePath(challengeId)).data.status == 'finished'
        && request.resource.data.keys().hasOnly([
            'challengeId', 'hostUserId', 'categoryId', 'restaurantId', 'title',
            'participantIds', 'participants', 'startedAt', 'finishedAt',
            'createdAt'
          ])
        && request.resource.data.challengeId == challengeId
        && request.resource.data.hostUserId == request.auth.uid
        && request.resource.data.categoryId == get(challengePath(challengeId)).data.categoryId
        && request.resource.data.restaurantId == get(challengePath(challengeId)).data.restaurantId
        && request.resource.data.title == get(challengePath(challengeId)).data.title
        && request.resource.data.startedAt == get(challengePath(challengeId)).data.startedAt
        && request.resource.data.finishedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.participantIds == get(challengePath(challengeId)).data.participantIds
        && isExactResult(
          challengeId,
          request.resource.data.participants,
          request.resource.data.participantIds
        );

      // Spark: el host materializa processingStatus / winnerIds (sin Cloud Functions).
      allow update: if isSignedIn()
        && resource.data.hostUserId == request.auth.uid
        && request.resource.data.hostUserId == resource.data.hostUserId
        && request.resource.data.challengeId == resource.data.challengeId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['processingStatus', 'winnerIds', 'totalUnits', 'officialAt'])
        && request.resource.data.processingStatus in ['pending', 'processing', 'official', 'failed']
        && request.resource.data.winnerIds is list;

      allow delete: if false;
    }

    // ---- Fase 5: stats / rankings / records ----
    // Spark: escritura del host tras finalizar. Blaze/Functions sigue siendo
    // el camino preferido a largo plazo (Admin SDK).

    function isChallengeHost(challengeId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/challenges/$(challengeId))
        && get(/databases/$(database)/documents/challenges/$(challengeId)).data.hostUserId
            == request.auth.uid;
    }

    function challengeFinished(challengeId) {
      return exists(/databases/$(database)/documents/challenges/$(challengeId))
        && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status
            == 'finished';
    }

    match /userStatistics/{uid} {
      allow get: if isOwner(uid)
        || (exists(/databases/$(database)/documents/users/$(uid))
            && get(/databases/$(database)/documents/users/$(uid)).data.visibility == 'public'
            && get(/databases/$(database)/documents/users/$(uid)).data.isActive == true);
      allow list: if false;
      // Host actualiza stats de participantes de un reto finalizado.
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll([
            'challengeCount', 'winCount', 'totalUnits', 'bestScore',
            'lastOfficialChallengeId'
          ])
        && request.resource.data.lastOfficialChallengeId is string
        && isChallengeHost(request.resource.data.lastOfficialChallengeId)
        && challengeFinished(request.resource.data.lastOfficialChallengeId)
        && uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.lastOfficialChallengeId)).data.participantIds
        && request.resource.data.challengeCount is int
        && request.resource.data.winCount is int
        && request.resource.data.totalUnits is int
        && request.resource.data.bestScore is int
        && request.resource.data.challengeCount >= 0
        && request.resource.data.winCount >= 0
        && request.resource.data.totalUnits >= 0
        && request.resource.data.bestScore >= 0;
      allow delete: if false;
    }

    match /leaderboards/{scopeKey} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasAll(['scopeKey', 'topAmount', 'lastChallengeId'])
        && request.resource.data.scopeKey == scopeKey
        && request.resource.data.topAmount is int
        && request.resource.data.topAmount >= 0
        && request.resource.data.lastChallengeId is string
        && isChallengeHost(request.resource.data.lastChallengeId)
        && challengeFinished(request.resource.data.lastChallengeId);
      allow delete: if false;

      match /entries/{uid} {
        allow get, list: if isSignedIn();
        allow create, update: if isSignedIn()
          && request.resource.data.userId == uid
          && request.resource.data.amount is int
          && request.resource.data.wins is int
          && request.resource.data.amount >= 0
          && request.resource.data.wins >= 0
          && request.resource.data.lastChallengeId is string
          && isChallengeHost(request.resource.data.lastChallengeId)
          && challengeFinished(request.resource.data.lastChallengeId)
          && uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.lastChallengeId)).data.participantIds;
        allow delete: if false;
      }
    }

    match /recordHistory/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasAll([
            'scopeKey', 'score', 'userId', 'challengeId', 'eventType', 'achievedAt'
          ])
        && request.resource.data.score is int
        && request.resource.data.eventType in ['created', 'broken', 'tied']
        && isChallengeHost(request.resource.data.challengeId)
        && challengeFinished(request.resource.data.challengeId);
      allow update, delete: if false;
    }

    match /resultProcessing/{challengeId} {
      allow get: if isChallengeHost(challengeId);
      allow list: if false;
      allow create, update: if isChallengeHost(challengeId)
        && challengeFinished(challengeId)
        && request.resource.data.challengeId == challengeId
        && request.resource.data.contentHash is string
        && request.resource.data.status == 'official';
      allow delete: if isChallengeHost(challengeId);
    }

    match /categoryStats/{categoryId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    match /restaurantCategoryStats/{id} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ───────────────────────── Fase 6: social ─────────────────────────

    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    match /friendships/{fid} {
      // resource == null: lectura vacia en transacciones / getRelation.
      allow get: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.userIds);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
            'userIds', 'requesterId', 'addresseeId', 'status',
            'requester', 'addressee', 'createdAt', 'updatedAt'
          ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.addresseeId is string
        && request.resource.data.addresseeId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.userIds is list
        && request.resource.data.userIds.size() == 2
        && request.auth.uid in request.resource.data.userIds
        && request.resource.data.addresseeId in request.resource.data.userIds
        && fid == friendshipId(request.auth.uid, request.resource.data.addresseeId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isSignedIn()
        && (
          // Transiciones normales (aceptar / rechazar / cancelar / eliminar)
          (request.auth.uid in resource.data.userIds
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt', 'acceptedAt'])
            && request.resource.data.updatedAt == request.time
            && (
              (resource.data.status == 'pending'
                && resource.data.addresseeId == request.auth.uid
                && request.resource.data.status in ['accepted', 'rejected']
                && (request.resource.data.status != 'accepted'
                    || request.resource.data.acceptedAt == request.time))
              || (resource.data.status == 'pending'
                && resource.data.requesterId == request.auth.uid
                && request.resource.data.status == 'cancelled')
              || (resource.data.status == 'accepted'
                && request.resource.data.status == 'cancelled')
            ))
          ||
          // Reenviar solicitud tras cancelar/rechazar (set completo → update)
          (resource.data.status in ['cancelled', 'rejected']
            && request.resource.data.keys().hasOnly([
                'userIds', 'requesterId', 'addresseeId', 'status',
                'requester', 'addressee', 'createdAt', 'updatedAt'
              ])
            && request.resource.data.requesterId == request.auth.uid
            && request.resource.data.addresseeId is string
            && request.resource.data.addresseeId != request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.userIds is list
            && request.resource.data.userIds.size() == 2
            && request.auth.uid in request.resource.data.userIds
            && request.resource.data.addresseeId in request.resource.data.userIds
            && fid == friendshipId(request.auth.uid, request.resource.data.addresseeId)
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time)
        );

      allow delete: if false;
    }

    match /challengeInvitations/{id} {
      allow get: if isSignedIn()
        && (resource == null
            || request.auth.uid == resource.data.fromUserId
            || request.auth.uid == resource.data.toUserId);
      allow list: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.toUserId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.challengeId is string
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
        && request.auth.uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds
        && exists(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.toUserId)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.toUserId))).data.status == 'accepted';

      // Reenviar invitacion tras rechazar/expirar (set → update)
      allow update: if isSignedIn()
        && (
          (resource.data.toUserId == request.auth.uid
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'respondedAt'])
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.respondedAt == request.time)
          ||
          (resource.data.status in ['rejected', 'expired', 'accepted']
            && request.resource.data.fromUserId == request.auth.uid
            && request.resource.data.toUserId == resource.data.toUserId
            && request.resource.data.status == 'pending'
            && request.resource.data.challengeId == resource.data.challengeId
            && request.resource.data.createdAt == request.time
            && request.auth.uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds
            && exists(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.toUserId)))
            && get(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, request.resource.data.toUserId))).data.status == 'accepted')
        );

      allow delete: if false;
    }

    // ───────────────────────── Fase 7: actividades / feed ─────────────────
    // Oficiales: solo Admin SDK (Functions). Cliente solo puede crear
    // friendJoinedChallenge como actor propio.

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/friendships/$(friendshipId(a, b)))
        && get(/databases/$(database)/documents/friendships/$(friendshipId(a, b))).data.status == 'accepted';
    }

    function canReadActivity() {
      return isSignedIn() && (
        resource.data.actorUserId == request.auth.uid
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'friends'
            && areFriends(request.auth.uid, resource.data.actorUserId))
      );
    }

    match /activities/{activityId} {
      allow get: if canReadActivity();
      // Queries deben restringirse a docs legibles (rules no son filtros).
      allow list: if canReadActivity();

      allow create: if isSignedIn()
        && (
          // join: solo friendJoinedChallenge del actor
          (request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.type == 'friendJoinedChallenge'
            && request.resource.data.keys().hasOnly([
                'type', 'actorUserId', 'actorUsername', 'actorDisplayName',
                'actorAvatarStyle', 'actorAvatarSeed', 'actorAvatarOptions',
                'visibility', 'createdAt', 'challengeId', 'categoryId',
                'categoryName', 'categoryIcon', 'restaurantId', 'restaurantName'
              ])
            && request.resource.data.challengeId is string
            && request.resource.data.categoryId is string
            && request.resource.data.visibility in ['public', 'friends']
            && request.resource.data.createdAt == request.time
            && activityId == request.resource.data.challengeId + '_' + request.auth.uid + '_friendJoinedChallenge'
            && exists(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId))
            // getAfter: en la misma transaccion de join el uid ya esta en participantIds.
            && request.auth.uid in getAfter(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds
            && getAfter(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.visibility in ['public', 'friends'])
          ||
          // Spark: host escribe actividades oficiales al materializar resultado
          (request.resource.data.type in [
              'challengeCompleted', 'challengeWon', 'recordCreated', 'recordBroken'
            ]
            && request.resource.data.challengeId is string
            && isChallengeHost(request.resource.data.challengeId)
            && challengeFinished(request.resource.data.challengeId)
            && request.resource.data.actorUserId is string
            && request.resource.data.actorUserId in get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds
            && request.resource.data.visibility in ['public', 'friends']
            && activityId == request.resource.data.challengeId + '_'
                + request.resource.data.actorUserId + '_'
                + request.resource.data.type)
        );

      allow update: if isSignedIn()
        && resource.data.actorUserId == request.auth.uid
        && resource.data.type == 'friendJoinedChallenge'
        && request.resource.data.type == 'friendJoinedChallenge'
        && request.resource.data.actorUserId == request.auth.uid
        && request.resource.data.visibility in ['public', 'friends']
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'actorUsername', 'actorDisplayName', 'actorAvatarStyle',
              'actorAvatarSeed', 'actorAvatarOptions', 'visibility',
              'categoryName', 'categoryIcon', 'restaurantName'
            ]);

      allow delete: if false;
    }

    // ───────────────────────── Fase 8: notificaciones ─────────────────
    // Solo el destinatario lee/marca leidas. Create: Admin SDK / Functions.

    match /notifications/{notificationId} {
      allow get: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid;

      allow create: if isSignedIn()
        && request.resource.data.recipientUserId is string
        && request.resource.data.read == false
        && (
          // Oficiales de reto (host Spark)
          (request.resource.data.type in [
              'challengeCompleted', 'challengeWon', 'recordCreated', 'recordBroken'
            ]
            && request.resource.data.challengeId is string
            && isChallengeHost(request.resource.data.challengeId)
            && challengeFinished(request.resource.data.challengeId)
            && request.resource.data.recipientUserId in
                get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds)
          ||
          // Solicitud de amistad: el remitente notifica al destinatario
          (request.resource.data.type == 'friendRequest'
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.recipientUserId != request.auth.uid
            && request.resource.data.friendshipId is string
            && notificationId == 'friendRequest_' + request.resource.data.friendshipId
            && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.requesterId
                == request.auth.uid
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.addresseeId
                == request.resource.data.recipientUserId
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.status
                == 'pending')
          ||
          // Aceptacion: el destinatario notifica al remitente
          (request.resource.data.type == 'friendRequestAccepted'
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.recipientUserId != request.auth.uid
            && request.resource.data.friendshipId is string
            && notificationId == 'friendAccepted_' + request.resource.data.friendshipId
            && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.addresseeId
                == request.auth.uid
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.requesterId
                == request.resource.data.recipientUserId
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.status
                == 'accepted')
          ||
          // Invitacion a reto
          (request.resource.data.type == 'challengeInvitation'
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.recipientUserId != request.auth.uid
            && request.resource.data.challengeId is string
            && notificationId == 'challengeInvitation_'
                + request.resource.data.challengeId + '_'
                + request.resource.data.recipientUserId
            && exists(/databases/$(database)/documents/challengeInvitations/$(request.resource.data.challengeId + '_' + request.resource.data.recipientUserId))
            && get(/databases/$(database)/documents/challengeInvitations/$(request.resource.data.challengeId + '_' + request.resource.data.recipientUserId)).data.fromUserId
                == request.auth.uid
            && get(/databases/$(database)/documents/challengeInvitations/$(request.resource.data.challengeId + '_' + request.resource.data.recipientUserId)).data.toUserId
                == request.resource.data.recipientUserId
            && get(/databases/$(database)/documents/challengeInvitations/$(request.resource.data.challengeId + '_' + request.resource.data.recipientUserId)).data.status
                == 'pending')
          ||
          // Amigo se unio a un reto
          (request.resource.data.type == 'friendJoinedChallenge'
            && request.resource.data.actorUserId == request.auth.uid
            && request.resource.data.recipientUserId != request.auth.uid
            && request.resource.data.challengeId is string
            && notificationId == 'friendJoined_'
                + request.resource.data.challengeId + '_'
                + request.auth.uid + '_'
                + request.resource.data.recipientUserId
            && request.auth.uid in get(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.participantIds
            && areFriends(request.auth.uid, request.resource.data.recipientUserId))
        );

      allow update: if isSignedIn()
        && resource.data.recipientUserId == request.auth.uid
        && request.resource.data.recipientUserId == resource.data.recipientUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if false;
    }

  }
}
